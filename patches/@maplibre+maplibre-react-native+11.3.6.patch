+/// supercluster indexes Point features only. Any other geometry in a clustered
+/// FeatureCollection — a Polygon, a MultiPoint, or a feature whose `geometry` is
+/// null (legal GeoJSON, parsed as MLNEmptyFeature) — makes its Zoom constructor
+/// throw bad_variant_access from C++, which nothing on the ObjC side catches:
+/// the process aborts. Drop such features up front and say so, instead.
+/// Single (non-collection) shapes never reach supercluster and pass through.
+/// See maplibre/maplibre-react-native#1635.
+- (MLNShape *)clusterSafeShape:(MLNShape *)shape {
+  if (shape == nil || _cluster == nil || [_cluster intValue] != 1) {
+    return shape;
+  }
+  if (![shape isKindOfClass:[MLNShapeCollectionFeature class]]) {
+    return shape;
+  }
+  MLNShapeCollectionFeature *collection = (MLNShapeCollectionFeature *)shape;
+  NSMutableArray<MLNShape<MLNFeature> *> *points =
+      [NSMutableArray arrayWithCapacity:collection.shapes.count];
+  for (MLNShape<MLNFeature> *feature in collection.shapes) {
+    if ([feature isKindOfClass:[MLNPointFeature class]]) {
+      [points addObject:feature];
+    }
+  }
+  NSUInteger dropped = collection.shapes.count - points.count;
+  if (dropped == 0) {
+    return shape;
+  }
+  RCTLogWarn(@"[MLRNGeoJSONSource] source '%@' is clustered but %lu of %lu features are not "
+             @"Point geometries; they were dropped because supercluster cannot index them.",
+             self.id, (unsigned long)dropped, (unsigned long)collection.shapes.count);
+  return [MLNShapeCollectionFeature shapeCollectionWithShapes:points];
+}
