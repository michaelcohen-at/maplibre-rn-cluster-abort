+- (void)prepareForRecycle {
+  [super prepareForRecycle];
+  // Fabric hands this view to the next <GeoJSONSource> of ANY kind. The wrapped
+  // MLRNGeoJSONSource still holds the previous component's MLNShapeSource — whose
+  // cluster options are immutable — so the next component's `data` would be pushed
+  // into it by setShape: before the new source is even created. A clustered source
+  // receiving non-Point features aborts the process from C++ (bad_variant_access in
+  // supercluster). Start the next life with a fresh wrapper, as MLRNCameraComponentView
+  // and MLRNLayerComponentView already do. See maplibre/maplibre-react-native#1635.
+  // And forget the previous props. Fabric passes oldProps:nullptr on Create, and
+  // updateProps diffs against _props — so without this reset, any prop that is
+  // EQUAL to the previous component's (a source remounting under the same id, the
+  // same cluster flag) is never applied to the fresh wrapper. A nil id then reaches
+  // -[MLNStyle sourceWithIdentifier:] and segfaults in strlen. Same pattern as
+  // MLRNCameraComponentView.prepareView.
+  static const auto defaultProps = std::make_shared<const MLRNGeoJSONSourceProps>();
+  _props = defaultProps;
+  [self prepareView];
+}
